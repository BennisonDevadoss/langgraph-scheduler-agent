# ###################################
# APP CONFIGURATION
# ###################################

PORT="5050"
HOST="localhost"
LOG_LEVEL="INFO"
ENVIRONMENT="development" # either "production", "development" or "staging"
BACKEND_URL="http://localhost:5050"
JWT_SECRET_KEY="your_jwt_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ###################################
# CORS CONFIGURATION
# ###################################
ALLOWED_ORIGIN="http://localhost:8080,http://localhost:3000,http://localhost:5173"

# ###################################
# DATABASE CONFIGURATION
# ###################################
DATABASE_URL="postgresql://username:password@host:port/database_name"

# ###################################
# EMBEDDING MODLE
# ###################################
EMBEDDING_MODEL="models/gemini-embedding-001"
EMBEDDING_DIMENSION="768"
EMBEDDING_MODEL_PROVIDER="google"

# ###################################
# LLM MODLE
# ###################################
LLM_MODEL="models/gemini-2.0-flash" # default
LLM_PROVIDER="google" # default
LLM_PROVIDER_API_KEY=""

# ###################################
# MILVUS VECTOR DB
# ###################################
MILVUS_DB="agentic_rag"
MILVUS_PORT=19530
MILVUS_HOST="localhost"

# ###################################
# PG VECTOR DB
# ###################################
PG_VECTOR_DB_URL="postgresql://username:password@host:port/database_name"

# ###################################
# REDIS CONFIG
# ###################################
REDIS_BASE_URL="redis://localhost:6379/0"

# ###################################
# CELERY CONFIG
# ###################################
MAX_RETRIES=3
BROKER_HOST="postgresql://username:password@host:port/database_name"

# ###################################
# CALENDAR CONFIG
# ###################################
CALENDAR_ORGANIZER_EMAIL="your_email@example.com"
CALENDAR_WORKING_HOURS_END=17
CALENDAR_WORKING_HOURS_START=9
CALENDAR_SLOT_DURATION_MINUTES=30

# ###################################
# LANGSMITH CONFIG
# ###################################
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your_langsmith_api_key"
LANGSMITH_PROJECT="your_langsmith_project"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
